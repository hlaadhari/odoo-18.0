<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue du tableau de bord STEG -->
    <record id="view_steg_dashboard_form" model="ir.ui.view">
        <field name="name">steg.dashboard.form</field>
        <field name="model">steg.dashboard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord STEG" create="false" edit="false" delete="false" class="steg_dashboard">
                <header>
                    <button name="action_new_move_in" type="object" string="Nouvelle Entrée" class="btn-primary"/>
                    <button name="action_new_move_out" type="object" string="Nouvelle Sortie" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>🏢 Système de Gestion des Stocks STEG</h1>
                        <h3>Tableau de bord - Société Tunisienne de l'Électricité et du Gaz</h3>
                    </div>
                    
                    <!-- KPI cards -->
                    <div class="steg_kpi_grid">
                        <div class="steg_kpi_card">
                            <div class="steg_kpi_title">Total Pièces</div>
                            <div class="steg_kpi_value"><field name="total_products" readonly="1" nolabel="1"/></div>
                            <div class="steg_kpi_hint">Articles inventoriés</div>
                        </div>
                        <div class="steg_kpi_card">
                            <div class="steg_kpi_title">Alertes Stock Bas</div>
                            <div class="steg_kpi_value"><field name="low_stock_count" readonly="1" nolabel="1"/></div>
                            <div class="steg_kpi_hint">Sous le minimum</div>
                        </div>
                        <div class="steg_kpi_card">
                            <div class="steg_kpi_title">En attente</div>
                            <div class="steg_kpi_value"><field name="pending_validations" readonly="1" nolabel="1"/></div>
                            <div class="steg_kpi_hint">Validations</div>
                        </div>
                        <div class="steg_kpi_card">
                            <div class="steg_kpi_title">Divisions Actives</div>
                            <div class="steg_kpi_value"><field name="total_divisions" readonly="1" nolabel="1"/></div>
                            <div class="steg_kpi_hint">Unités</div>
                        </div>
                    </div>

                    <!-- Alertes -->
                    <div class="steg_section">
                        <div class="steg_section_header">
                            <div class="steg_section_title">Alertes Stock</div>
                            <div class="steg_actions_row">
                                <button name="action_view_low_stock" type="object" string="Voir Stock Bas" class="btn btn-outline-primary"/>
                                <button name="action_view_out_of_stock" type="object" string="Voir Ruptures" class="btn btn-outline-secondary"/>
                            </div>
                        </div>
                        <div class="steg_list_item">
                            <div>Stock Bas</div>
                            <div class="steg_badge_critical"><field name="low_stock_count" readonly="1" nolabel="1"/></div>
                        </div>
                        <div class="steg_list_item">
                            <div>Ruptures</div>
                            <div class="steg_badge_low"><field name="out_of_stock_count" readonly="1" nolabel="1"/></div>
                        </div>
                    </div>
                    
                    <!-- Répartition par division -->
                    <div class="steg_section" style="margin-top:12px;">
                        <div class="steg_section_header">
                            <div class="steg_section_title">Répartition par Division</div>
                        </div>
                        <div class="steg_list_item"><div>Télécom</div><div class="steg_badge_low"><field name="telecom_products" readonly="1" nolabel="1"/></div></div>
                        <div class="steg_list_item"><div>Téléconduite</div><div class="steg_badge_low"><field name="teleconduite_products" readonly="1" nolabel="1"/></div></div>
                        <div class="steg_list_item"><div>SCADA</div><div class="steg_badge_low"><field name="scada_products" readonly="1" nolabel="1"/></div></div>
                        <div class="steg_list_item"><div>Communes</div><div class="steg_badge_low"><field name="common_products" readonly="1" nolabel="1"/></div></div>
                    </div>

                    <!-- Actions rapides (éviter la duplication avec l'en-tête) -->
                    <group string="⚡ Actions Rapides">
                        <group>
                            <button name="action_view_products" type="object" string="📦 Gérer Pièces" class="btn-outline-primary"/>
                            <button name="action_view_moves" type="object" string="📋 Historique" class="btn-outline-secondary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour le tableau de bord -->
    <record id="action_steg_dashboard" model="ir.actions.act_window">
        <field name="name">Tableau de bord STEG</field>
        <field name="res_model">steg.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'readonly'}</field>
        <field name="res_id" ref="steg_dashboard_default"/>
    </record>

    <!-- Menu principal STEG (remplace l'ancien) -->
    <record id="menu_steg_main" model="ir.ui.menu">
        <field name="name">STEG Stock</field>
        <field name="sequence">5</field>
        <field name="action" ref="action_steg_dashboard"/>
        <field name="web_icon">steg_stock_management,static/description/icon.png</field>
    </record>

    <!-- Sous-menus -->
    <menuitem id="menu_steg_operations" name="Opérations" parent="menu_steg_main" sequence="10"/>
    <menuitem id="menu_steg_config" name="Configuration" parent="menu_steg_main" sequence="20"/>
    
    <!-- Menus opérations -->
    <menuitem id="menu_steg_moves" name="Mouvements" parent="menu_steg_operations" action="action_steg_stock_move" sequence="10"/>
    <menuitem id="menu_steg_products_menu" name="Pièces" parent="menu_steg_operations" action="action_steg_product" sequence="20"/>
    
    <!-- Menus configuration -->
    <menuitem id="menu_steg_divisions_menu" name="Divisions" parent="menu_steg_config" action="action_steg_division" sequence="10"/>
</odoo>