<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_steg_stock_move_tree" model="ir.ui.view">
        <field name="name">steg.stock.move.list</field>
        <field name="model">steg.stock.move</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-warning="state == 'waiting'" decoration-info="state == 'validated'">
                <field name="name"/>
                <field name="date"/>
                <field name="move_type"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="total_value"/>
                <field name="division_id"/>
                <field name="user_id" string="Demandeur"/>
                <field name="validator_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_steg_stock_move_form" model="ir.ui.view">
        <field name="name">steg.stock.move.form</field>
        <field name="model">steg.stock.move</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
            <button name="action_submit_for_validation" type="object" string="Soumettre pour validation" 
                class="btn-primary"/>
            <button name="action_validate" type="object" string="Valider" 
                class="btn-success"/>
            <button name="action_execute" type="object" string="Exécuter" 
                class="btn-success"/>
            <button name="action_cancel" type="object" string="Annuler" 
                class="btn-secondary"/>
            <button name="action_reset_to_draft" type="object" string="Remettre en brouillon" 
                class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,validated,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Informations générales">
                            <field name="date" required="1"/>
                            <field name="move_type" required="1"/>
                            <field name="division_id" required="1"/>
                            <field name="user_id" string="Demandeur" readonly="1"/>
                        </group>
                        <group string="Validation">
                            <field name="validator_id" readonly="1"/>
                            <field name="validation_date" readonly="1"/>
                            <field name="done_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Produit et quantité">
                        <group>
                            <field name="scanned_barcode" placeholder="Scanner ou saisir le code-barres"/>
                            <field name="product_id" required="1"/>
                            <field name="quantity" required="1"/>
                        </group>
                        <group>
                            <field name="unit_price"/>
                            <field name="total_value" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Informations complémentaires">
                        <group>
                            <field name="supplier_id"/>
                            <field name="purchase_order_ref"/>
                        </group>
                    </group>
                    
                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Description du mouvement"/>
                        <field name="reason" nolabel="1" placeholder="Motif du mouvement"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_steg_stock_move" model="ir.actions.act_window">
        <field name="name">Mouvements STEG</field>
        <field name="res_model">steg.stock.move</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu supprimé - maintenant géré dans steg_dashboard_views.xml -->
    <!-- Requests: list and form -->
    <record id="view_steg_stock_request_tree" model="ir.ui.view">
        <field name="name">steg.stock.request.list</field>
        <field name="model">steg.stock.request</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-danger="state == 'rejected'" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="request_type"/>
                <field name="division_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_steg_stock_request_form" model="ir.ui.view">
        <field name="name">steg.stock.request.form</field>
        <field name="model">steg.stock.request</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Soumettre" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approuver" class="btn-success"/>
                    <button name="action_reject" type="object" string="Rejeter" class="btn-secondary"/>
                    <button name="action_process" type="object" string="Traiter" class="btn-success"/>
                    <button name="action_cancel" type="object" string="Annuler" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="request_type"/>
                            <field name="division_id"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason" placeholder="Motif"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes">
                            <field name="line_ids">
                                <form>
                                    <tree editable="bottom">
                                        <field name="product_id" required="1"/>
                                        <field name="quantity" required="1"/>
                                        <field name="uom_id" optional="show"/>
                                    </tree>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_steg_stock_request" model="ir.actions.act_window">
        <field name="name">Demandes de Stock</field>
        <field name="res_model">steg.stock.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_steg_requests" name="Demandes" parent="steg_stock_management.menu_steg_operations" action="action_steg_stock_request" sequence="15"/>
    
</odoo>


